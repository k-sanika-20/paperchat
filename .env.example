# Get a free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=paste_your_key_here

# --- models -------------------------------------------------------
# Override these if a model name changes or your key lacks access.
# List what your key can actually use:  python scripts/list_models.py
CHAT_MODEL=gemini-3.6-flash
EMBED_MODEL=gemini-embedding-001
TEMPERATURE=0.1

# --- chunking -----------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- retrieval ----------------------------------------------------
TOP_K=5
CANDIDATE_K=20
USE_HYBRID=true
DENSE_WEIGHT=0.5     # 0.0 = pure BM25, 1.0 = pure embeddings
RRF_K=60

# --- re-ranking ---------------------------------------------------
# A precision pass: the model reads the fused candidates and scores each
# for relevance. Costs one extra call per question.
USE_RERANK=true
RERANK_CANDIDATES=18     # how many candidates the re-ranker sees
RERANK_MAX_CHARS=600     # per-passage truncation in the re-rank prompt
RERANK_MIN_SCORE=1.0     # drop passages scoring below this (0-3 scale)

# --- source previews ----------------------------------------------
# Keep a copy of each PDF beside the index so cited pages can be rendered.
STORE_SOURCE_PDFS=true
PREVIEW_DPI=110

# --- throughput (free tier is rate-limited) -----------------------
EMBED_BATCH_SIZE=32
EMBED_MAX_RETRIES=5
