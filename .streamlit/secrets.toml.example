# Streamlit Community Cloud secrets.
#
# LOCAL  : copy this to .streamlit/secrets.toml (gitignored) - or just use .env
# DEPLOY : paste the contents into "Advanced settings -> Secrets" when you
#          deploy, or into App settings -> Secrets afterwards.
#
# Never commit the real file.

GOOGLE_API_KEY = "paste_your_key_here"

# Strongly recommended for a public deployment: without it, anyone who finds
# your URL can spend your Gemini quota.
APP_PASSWORD = "pick_something_and_share_it_only_with_reviewers"

CHAT_MODEL = "gemini-3.6-flash"
EMBED_MODEL = "gemini-embedding-001"

TOP_K = "5"
DENSE_WEIGHT = "0.5"
EMBED_BATCH_SIZE = "32"
USE_RERANK = "true"

# Hosted containers are small; previews cost disk and RAM.
STORE_SOURCE_PDFS = "true"
